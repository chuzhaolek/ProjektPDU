liczba_przejazdow < 500,                             # Mało przejazdów
conditions %in% c("Clear", "Partially cloudy")       # Pogoda teoretycznie "dobra"
) %>%
# 2. Dodanie nowej kolumny z nazwą dnia tygodnia
mutate(
# Usuwamy argument 'locale', ponieważ Windows domyślnie użyje polskiego.
# Ustawiamy week_start = 1, aby tydzień zaczynał się od poniedziałku.
dzien_tygodnia = wday(data_jazdy, label = TRUE, abbr = FALSE, week_start = 1)
) %>%
# 3. Wybór najważniejszych kolumn do analizy
select(data_jazdy, dzien_tygodnia, temp_C, snow, precip, liczba_przejazdow, conditions)
# Zobaczmy, co to za dni:
View(anomalie)
# 1. PRZYGOTOWANIE WSPÓLNEJ BAZY DANYCH (uzupełnienie 23 lutego zerem)
pelne_daty <- data.frame(
data_jazdy = seq(min(dane_polaczone$data_jazdy), max(dane_polaczone$data_jazdy), by = "day")
)
dane_uzupelnione <- pelne_daty %>%
left_join(dane_polaczone, by = "data_jazdy") %>%
mutate(liczba_przejazdow = ifelse(is.na(liczba_przejazdow), 0, liczba_przejazdow))
# Przygotowanie punktów do wyróżnienia (wyodrębnienie rekordów)
zawieja <- dane_uzupelnione %>% filter(data_jazdy == as.Date("2026-02-23"))
rekord_wiosna <- dane_uzupelnione %>% filter(data_jazdy == as.Date("2026-03-10"))
# ==========================================
# WYKRES 1: Tylko zalegający śnieg i zimno
# ==========================================
ggplot(dane_uzupelnione, aes(x = data_jazdy, y = liczba_przejazdow)) +
geom_line(color = "#2c3e50", size = 1, alpha = 0.7) +
geom_point(data = anomalie, aes(x = data_jazdy, y = liczba_przejazdow),
fill = "#e74c3c", color = "white", shape = 21, size = 4, stroke = 1) +
annotate("label", x = as.Date("2025-12-31"), y = 800, label = "Sylwester\n(13 przejazdów)",
color = "#c0392b", fill = "white", hjust = 0, fontface = "bold") +
annotate("label", x = as.Date("2026-01-28"), y = -150, label = "Zalegający śnieg\npo zamieci z 25.01",
color = "#c0392b", fill = "white", hjust = 0.5, fontface = "bold") +
annotate("label", x = as.Date("2026-02-08"), y = 1200, label = "-12°C\n(Niedziela)",
color = "#c0392b", fill = "white", hjust = 0, fontface = "bold") +
# DODANE: Etykieta wyjaśniająca punkt z 24 lutego (skutki śnieżycy)
annotate("label", x = as.Date("2026-02-24"), y = 600, label = "Dzień po\nśnieżycy (24.02)",
color = "#c0392b", fill = "white", hjust = 0, fontface = "bold") +
scale_x_date(date_breaks = "1 month", date_labels = "%b %Y") +
scale_y_continuous(limits = c(-300, 4500)) +
labs(
title = "Dzienna liczba przejazdów w czasie (Anomalie zimowe)",
subtitle = "Czerwonymi punktami zaznaczono dni z ładną pogodą, ale znikomym ruchem rowerowym",
x = "Data",
y = "Liczba przejazdów"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "#7f8c8d", size = 12),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(linetype = "dashed", color = "lightgray")
)
# ==========================================
# WYKRES 2: Ekstremalna śnieżyca i wiosna
# ==========================================
ggplot(dane_uzupelnione, aes(x = data_jazdy, y = liczba_przejazdow)) +
geom_line(color = "#2c3e50", size = 1, alpha = 0.7) +
geom_point(data = zawieja, aes(x = data_jazdy, y = liczba_przejazdow),
fill = "#2980b9", color = "white", shape = 21, size = 5, stroke = 1) +
annotate("label", x = as.Date("2026-02-23"), y = -250,
label = "Stan wyjątkowy\n(Śnieżyca: 0 przejazdów)",
color = "#2980b9", fill = "white", hjust = 0.5, fontface = "bold") +
geom_point(data = rekord_wiosna, aes(x = data_jazdy, y = liczba_przejazdow),
fill = "#27ae60", color = "white", shape = 21, size = 5, stroke = 1) +
annotate("label", x = as.Date("2026-03-10"), y = 3800,
label = "Wiosenne przebudzenie\n(10 marca: 3033 przejazdy)",
color = "#27ae60", fill = "white", hjust = 0.5, fontface = "bold") +
scale_x_date(date_breaks = "1 month", date_labels = "%b %Y") +
scale_y_continuous(limits = c(-300, 4500)) +
labs(
title = "Ekstremalne zjawiska pogodowe a ruch rowerowy",
subtitle = "Wpływ historycznej śnieżycy (23.02) oraz pierwszych dni wiosny",
x = "Data",
y = "Liczba przejazdów"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "#7f8c8d", size = 12),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(linetype = "dashed", color = "lightgray")
)
# ==========================================
# WYKRES 3: Turyści (Casual) vs Stali bywalcy (Member)
# ==========================================
# 1. Nowa agregacja uwzględniająca typ użytkownika (grupowanie po dwóch zmiennych)
statystyki_uzytkownicy <- dane %>%
group_by(data_jazdy, member_casual) %>%
summarise(liczba_przejazdow = n(), .groups = "drop") %>%
# Dołączamy dane pogodowe, aby mieć dostęp do temperatury
left_join(pogoda_wybrane, by = "data_jazdy")
# 2. Rysowanie wykresu
ggplot(statystyki_uzytkownicy, aes(x = temp_C, y = liczba_przejazdow, color = member_casual)) +
# Dodajemy punkty z lekką przezroczystością
geom_point(alpha = 0.6, size = 3) +
# Dodajemy linie trendu dla obu grup (bez szarego paska błędu se = FALSE dla przejrzystości)
geom_smooth(method = "lm", se = FALSE, size = 1.2) +
# Ręczne ustawienie kolorów i nazw dla legendy
scale_color_manual(
values = c("member" = "#2980b9", "casual" = "#e67e22"),
labels = c("casual" = "Turyści / Rekreacja (Casual)", "member" = "Stali bywalcy (Member)")
) +
# Opisy osi i tytuły
# Opisy osi i zaktualizowane tytuły
labs(
title = "Wrażliwość na pogodę: Turyści vs Stali bywalcy",
subtitle = "Zdecydowaną większość wiosennego wzrostu ruchu generują stali subskrybenci, a nie turyści",
x = "Średnia temperatura (°C)",
y = "Dzienna liczba przejazdów",
color = "Typ użytkownika"
) +
# Czysty motyw graficzny (motyw)
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 16),
legend.position = "bottom",
legend.title = element_text(face = "bold")
)
